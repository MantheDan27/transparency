<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Tool input -->
        <EditText
            android:id="@+id/toolInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_glass_card"
            android:hint="Enter IP or hostname"
            android:textColorHint="@color/text_tertiary"
            android:textColor="@color/text_primary"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:inputType="text"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp" />

        <!-- Tool buttons grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnPing"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_glass_button_secondary"
                android:text="@string/ping_tool"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnDns"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_glass_button_secondary"
                android:text="@string/dns_tool"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnTraceroute"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_glass_button_secondary"
                android:text="@string/traceroute_tool"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnPortScan"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_glass_button_secondary"
                android:text="@string/port_scan_tool"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Tool output -->
        <TextView
            android:id="@+id/toolOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:padding="16dp"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:minHeight="200dp"
            android:gravity="top" />
    </LinearLayout>
</ScrollView>
