<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_selected" />
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="@color/glow_cyan_strong" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_pressed" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#1EB4C8F0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_secondary" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#1EB4C8F0" />
        </shape>
    </item>
</selector>
